{
  "name": "sourcewell",
  "version": "0.1.0",
  "description": "Read-only research CLI for Sourcewell's public cooperative-purchasing data. Zero dependencies.",
  "type": "module",
  "private": true,
  "bin": { "sourcewell": "./bin/sourcewell.js" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/*.js",
    "build": "npx --yes esbuild@0.24.0 bin/sourcewell.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/sourcewell.mjs --log-level=warning && chmod +x dist/sourcewell.mjs"
  },
  "engines": { "node": ">=20" },
  "files": ["bin", "src", "dist", "README.md"]
}
